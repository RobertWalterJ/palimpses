#! title: Prime Ministers of Canada
#! lane: canada
#! asks: Who was prime minister of Canada
#! verb: become prime minister
#! past: became prime minister
#! kind: reigns
#! source: Wikidata
#! licence: CC0 1.0
#! url: https://query.wikidata.org/

# One row per TERM, not per person: Macdonald, Mackenzie King and others held
# the office more than once, and the gaps are the point of the question.

SELECT ?item ?name ?from ?to WHERE {
  ?item p:P39 ?st .
  ?st ps:P39 wd:Q839078 ;
      pq:P580 ?from .
  OPTIONAL { ?st pq:P582 ?to }
  FILTER NOT EXISTS { ?st wikibase:rank wikibase:DeprecatedRank }
  ?item rdfs:label ?name . FILTER(LANG(?name) = "en")
}
ORDER BY ?from
